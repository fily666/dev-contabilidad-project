{
  "name": "gestor-financiero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:push": "node --env-file=.env scripts/aplicar-migraciones.mjs",
    "db:seed": "node --env-file=.env scripts/aplicar-migraciones.mjs --seed",
    "db:reset": "node --env-file=.env scripts/reiniciar-base.mjs && npm run db:seed",
    "db:inspect": "node --env-file=.env scripts/inspeccionar-base.mjs",
    "db:verify-types": "node --env-file=.env scripts/verificar-tipos.mjs",
    "db:smoke": "node --env-file=.env scripts/humo-remoto.mjs",
    "prepare": "husky"
  },
  "//lint-staged": "Contexto.md §8.9. Prettier antes de ESLint: el formateo puede introducir un cambio que el lint deba revisar, no al contrario. `--no-warn-ignored` porque lint-staged pasa los archivos ignorados de eslint.config.mjs (database.types.ts) y el aviso de «archivo ignorado» cuenta contra --max-warnings 0: el commit fallaba por un archivo que el lint no debe revisar.",
  "lint-staged": {
    "*.{ts,tsx,css}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,md,mjs,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.5.7",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.27.0",
    "next": "15.5.22",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.83.0",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.110.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
