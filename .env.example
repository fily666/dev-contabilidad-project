# ─── Supabase ────────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role: SOLO servidor, exclusiva de /api/cron. Nunca exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Aplicacion ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protege /api/cron/*: se envia como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ─── Correo (Fase 4) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_REMITENTE=
