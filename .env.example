# ─── Acceso ──────────────────────────────────────────────────────────────────
# El sistema es monousuario: no hay cuentas ni registro. Se entra con este token.
# Es la ÚNICA barrera de acceso a toda la información financiera, así que conviene
# que sea largo y que no se parezca a una contraseña de ejemplo.
#   Generar uno fuerte:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TOKEN_ACCESO=Admin123!

# Secreto con el que se firma la cookie de sesión. Mínimo 32 caracteres.
#   Generar:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRETO_SESION=duuGT_dgcLvPDD2kk2O_fKhZQDO3GP3am6exPizf2gI

# ─── Supabase ────────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://iwxlpucuokjchthhzhdc.supabase.co

# Clave service_role: OMITE RLS y es la única con permisos sobre la base.
# La aplicación la usa desde el servidor para todo el acceso a datos y nunca llega
# al navegador. No hay clave anónima: sin usuarios de Supabase Auth no hay sesión
# que representar, y los roles públicos quedaron sin permisos a propósito (§9).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Conexión directa a PostgreSQL (Project Settings → Database → Connection string → URI).
# Solo la usan las migraciones y los scripts de scripts/; la aplicación nunca la lee.
# Contiene la contraseña del usuario postgres: acceso total a la base.
SUPABASE_DB_URL=postgresql://postgres.iwxlpucuokjchthhzhdc:S0p0rt3%21%212026@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# ─── Aplicacion ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protege /api/cron/*: se envia como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=AsGL4KfAOk5XJ-4m48pBILL0t0qBi2n-BZ45ioSaYH0

# ─── Correo (Fase 4) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_REMITENTE=
